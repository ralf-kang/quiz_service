# Quiz Service env vars

# PostgreSQL (setup_webservice.sh 가 생성한 DB/유저)
DATABASE_URL=postgresql+psycopg2://webservice_user:webservice_pass@localhost:5432/webservice_db

# Anthropic Claude API key. 비어 있어도 서버는 기동되며,
# LLM 이 필요한 엔드포인트만 503 으로 안내합니다.
ANTHROPIC_API_KEY=

# 사용 모델 (선택). 기본 claude-sonnet-4-6
ANTHROPIC_MODEL=claude-sonnet-4-6

# 업로드 최대 크기 (MB)
MAX_UPLOAD_MB=50

# 청크 길이 (문자)
CHUNK_SIZE=1000
